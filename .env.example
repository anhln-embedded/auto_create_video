# Auto_create_video Environment Configuration

# TTS Engine Selection: zerotts (offline CPU) or edge-tts (online lightweight)
TTS_ENGINE=zerotts

# ZeroTTS Configuration (CPU-based Vietnamese Zero-Shot)
ZEROTTS_VOICE=quangminh
ZEROTTS_THREADS=4
ZEROTTS_CFG_SCALE=1.0

# EdgeTTS Configuration
EDGE_TTS_VOICE=vi-VN-NamMinhNeural

# Video Layout Specs
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# Output Paths
AUDIO_OUTPUT_DIR=public/audio
VIDEO_OUTPUT_DIR=out
